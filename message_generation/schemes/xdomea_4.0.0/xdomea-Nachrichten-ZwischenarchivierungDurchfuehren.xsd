         <xs:complexContent>
            <xs:extension base="xdomea:NachrichtType">
               <xs:sequence>
                  <xs:element name="LfdNrNachrichtProTyp" type="xs:integer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die laufende Nummer der Nachrichten vom Typ 0721 in diesem Prozess übermittelt.</xs:documentation>
                     </xs:annotation>
