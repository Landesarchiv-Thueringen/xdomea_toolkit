                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Zwischenarchivierung.RueckuebertragungEmpfangBestaetigen.0724">
      <xs:annotation>
