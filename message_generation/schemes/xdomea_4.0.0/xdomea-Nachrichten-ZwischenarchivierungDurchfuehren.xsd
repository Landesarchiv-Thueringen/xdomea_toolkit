                     </xs:annotation>
                  </xs:element>
                  <xs:element name="LfdNrNachrichtProTyp" type="xs:integer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die laufende Nummer der Nachrichten vom Typ 0712 in diesem Prozess übermittelt. Die Nummer entspricht derjenigen von der korrespondierenden Nachricht vom Typ 0711 in diesem Prozess.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="GesamtanzahlNachrichtenProTyp" type="xs:integer">
