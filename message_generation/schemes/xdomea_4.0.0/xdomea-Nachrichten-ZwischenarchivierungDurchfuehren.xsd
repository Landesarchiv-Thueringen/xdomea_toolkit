                        <xs:documentation>Mit diesem Element wird die Gesamtanzahl der Nachrichten vom Typ 0712 in diesem Prozess übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="Anschreiben"
                              minOccurs="0"
                              type="xdomea:DokumentOderDokumentMitSchriftstueckType">
